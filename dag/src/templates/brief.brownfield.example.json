{
  "title": "brownfield example",
  "model": "composer-2.5",
  "greenfield": false,
  "languages": ["ts"],
  "test": {
    "cmd": "yarn",
    "args": ["test"]
  },
  "constraints": ["no cookies", "no git push"],
  "nodes": [
    {
      "id": "api-health",
      "commit": "feat(api): add health endpoint",
      "prompt": "Add a health route on the existing API package only.",
      "testCwd": "REPLACE_ME/packages/api"
    },
    {
      "id": "web-types",
      "commit": "feat(web): add session types",
      "prompt": "Add session types in the web package only.",
      "testCwd": "REPLACE_ME/packages/web"
    }
  ]
}

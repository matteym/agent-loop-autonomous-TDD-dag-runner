{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["run-dag-loop.ts", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
